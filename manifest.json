{
  "manifest_version": 3,
  "name": "RenderX Image Studio",
  "version": "1.0.2",
  "description": "High-speed bulk AI image generator with timeline sync for video editing, character/style lock, and multi-engine auto-fallback.",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "*://*.google.com/*",
    "*://gemini.google.com/*",
    "*://share.gemini.google/*",
    "*://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://gemini.google.com/share/*",
        "*://share.gemini.google/*"
      ],
      "js": [
        "js/gemini-content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open RenderX Image Studio"
  },
  "icons": {
    "128": "icons/icon128.png"
  }
}
