{
  "manifest_version": 3,
  "name": "RenderX Image Studio",
  "version": "1.2.0",
  "description": "Dual-mode account-level bulk media studio (Gemini Canvas & Google Flow) docked at 70vw inside Chrome.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://flow.google.com/*",
    "https://*.flow.google/*",
    "https://flow.google/*",
    "https://labs.google/*",
    "https://aitestkitchen.withgoogle.com/*",
    "https://*.google.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open RenderX Image Studio"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "content_canvas.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://flow.google.com/*",
        "https://*.flow.google/*",
        "https://flow.google/*",
        "https://labs.google/*",
        "https://aitestkitchen.withgoogle.com/*"
      ],
      "js": [
        "content_flow.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dashboard.html",
        "dashboard.css",
        "dashboard.js",
        "jszip.min.js",
        "libs/*",
        "icons/*",
        "js/*",
        "css/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "128": "icons/icon128.png"
  }
}
