{
  "manifest_version": 3,
  "name": "RenderX Image Studio",
  "version": "1.3.0",
  "description": "Zero-Tab Dual-Mode Account Bulk Media Studio (Gemini Canvas Direct RPC & Google Flow Direct API).",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "downloads",
    "webRequest"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://*.scf.usercontent.goog/*",
    "https://flow.google.com/*",
    "https://*.flow.google/*",
    "https://flow.google/*",
    "https://labs.google/*",
    "https://aitestkitchen.withgoogle.com/*",
    "https://aisandbox-pa.googleapis.com/*",
    "https://*.google.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open RenderX Image Studio"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://*.scf.usercontent.goog/*"
      ],
      "js": [
        "canvas_page_bridge.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://*.scf.usercontent.goog/*"
      ],
      "js": [
        "content_canvas.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://flow.google.com/*",
        "https://*.flow.google/*",
        "https://flow.google/*",
        "https://labs.google/*",
        "https://aitestkitchen.withgoogle.com/*"
      ],
      "js": [
        "flow_page_bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://flow.google.com/*",
        "https://*.flow.google/*",
        "https://flow.google/*",
        "https://labs.google/*",
        "https://aitestkitchen.withgoogle.com/*"
      ],
      "js": [
        "content_flow.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dashboard.html",
        "dashboard.css",
        "dashboard.js",
        "jszip.min.js",
        "libs/*",
        "icons/*",
        "js/*",
        "css/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "128": "icons/icon128.png"
  }
}
