{
  "manifest_version": 3,
  "name": "RenderX Image Studio",
  "version": "1.0.8",
  "description": "Dual-mode account-level bulk media studio (Gemini Canvas & Google Flow) with 75% right split-screen docking and unified scroll.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "downloads",
    "sidePanel"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://flow.google.com/*",
    "https://labs.google/*",
    "https://*.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "dashboard.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "content_canvas.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/*"
      ],
      "js": [
        "content_flow.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open RenderX Image Studio (Split-Screen Dock)"
  },
  "icons": {
    "128": "icons/icon128.png"
  }
}
