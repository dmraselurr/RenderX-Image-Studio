{
  "manifest_version": 3,
  "name": "RenderX Image Studio",
  "version": "1.1.0",
  "description": "Dual-mode account-level bulk media studio (Gemini Canvas & Google Flow) attached inside Chrome Side Panel.",
  "permissions": [
    "sidePanel",
    "tabs",
    "scripting",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://flow.google.com/*",
    "https://*.flow.google/*",
    "https://flow.google/*",
    "https://labs.google/*",
    "https://*.google.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "dashboard.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "content_canvas.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://flow.google.com/*",
        "https://*.flow.google/*",
        "https://flow.google/*",
        "https://labs.google/*",
        "https://aitestkitchen.withgoogle.com/*"
      ],
      "js": [
        "content_flow.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open RenderX Image Studio"
  },
  "icons": {
    "128": "icons/icon128.png"
  }
}
